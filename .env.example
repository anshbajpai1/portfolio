VITE_GITHUB_USERNAME=your-github-username
VITE_GITHUB_API_URL=https://api.github.com
VITE_LEETCODE_USERNAME=your-leetcode-username
# Optional: URL for a backend/serverless endpoint that proxies POST requests to LeetCode GraphQL.
# Local Vite and Vercel deployments work automatically through /api/leetcode/graphql.
VITE_LEETCODE_API_URL=
# Keep GitHub tokens server-side only. Never prefix secrets with VITE_.
